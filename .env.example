# Private key of a Base Sepolia wallet with test tokens
# Used for x402 micropayments to OpenGradient TEE nodes
# Format: 0x + 64 hex chars
APP_WALLET_PRIVATE_KEY=

# Optional: disable TLS verification for TEE devnet certs
NODE_TLS_REJECT_UNAUTHORIZED=0

# Redis (optional — memory fallback when unreachable)
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_ENABLED=true
# REDIS_KEY_PREFIX=csb
# REDIS_SIGNAL_TTL_SEC=60

# intelligent-trading-bot snapshot keys (default prefix itb)
# BOT_REDIS_KEY_PREFIX=itb
